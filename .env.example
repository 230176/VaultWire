# Application environment (copy this file to .env if needed)
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nepshield
# Set to true whenever the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
# URL-safe base64 encoding of exactly 32 random bytes. Generate once and keep stable.
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULT_ENCRYPTION_KEY=
# Research-build defaults: 1 MiB and a local ciphertext-only directory.
VAULT_MAX_FILE_SIZE_BYTES=1048576
VAULT_STORAGE_DIR=./vault_storage
